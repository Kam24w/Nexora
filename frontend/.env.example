# Copia este archivo como .env.local y completa los valores de tu proyecto Supabase
# (Project Settings -> API). La clave "anon" es pública; NUNCA pongas aquí la service_role.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Servicio local de diagnóstico (server.py) durante el desarrollo.
# `python build.py` usa "same-origin" al empaquetar: la API y la interfaz comparten servidor.
VITE_DIAGNOSIS_API_URL=http://127.0.0.1:5000
