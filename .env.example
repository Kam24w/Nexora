# Copia este archivo como .env (en la raíz, junto a server.py). Lo lee server.py al arrancar.
# Clave de la API de Groq para el motor de diagnóstico IA (https://console.groq.com/keys).
# Es secreta: nunca la pongas en frontend/.
GROQ_API_KEY=gsk_...

# App de escritorio (Nexora.exe): este mismo .env va junto al ejecutable.
# Opcional: puerto preferido (si está ocupado se usa el siguiente libre). Por defecto: 5000
# NEXORA_PORT=5000
# Opcional: NEXORA_NO_BROWSER=1 arranca sin abrir el navegador.
# NEXORA_NO_BROWSER=1

# Opcional: FLASK_DEBUG=1 activa el recargador y el depurador de Flask (solo desarrollo).
# FLASK_DEBUG=1

# Opcional: modelo de Groq (debe admitir JSON mode). Por defecto: openai/gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-120b
